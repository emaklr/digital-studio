# Database (PostgreSQL / Neon / other compatible provider)
DATABASE_URL=

# Resend enquiry and payment notifications
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=
LEAD_FROM_EMAIL=

# Distributed API rate limiting (Upstash Redis REST)
# Required in production for enquiries, checkout initialization and payment verification.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Browser origins allowed to submit forms and verify payments (comma-separated).
# Include the canonical production URL and any trusted preview origins.
TRUSTED_ORIGINS=

# Paystack NGN checkout. Keep both flags false until production readiness is approved.
PAYMENTS_ENABLED=false
NEXT_PUBLIC_PAYMENTS_ENABLED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
# Optional previous signing secret during Paystack key rotation.
PAYSTACK_WEBHOOK_SECRET_PREVIOUS=
USD_NGN_RATE=
NEXT_PUBLIC_SITE_URL=

# USD_NGN_RATE is a manually managed studio quote rate (NGN per USD), not a live market feed.
